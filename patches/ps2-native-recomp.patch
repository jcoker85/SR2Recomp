+namespace {
+// the words of the stick directions, in the order of kPadStickBase + 0..7
+const char *const kStickWords[8] = {"leftstick_left", "leftstick_right", "leftstick_up", "leftstick_down",
+                                    "rightstick_left", "rightstick_right", "rightstick_up", "rightstick_down"};
+}  // namespace
+
+std::string pad_input_word(int pad_input) {
+    if (pad_input == kPadLeftTrigger) return "lefttrigger";
+    if (pad_input == kPadRightTrigger) return "righttrigger";
+    if (pad_input >= kPadStickBase && pad_input < kPadStickBase + 8) return kStickWords[pad_input - kPadStickBase];
+    if (pad_input >= 0 && pad_input < SDL_CONTROLLER_BUTTON_MAX) {
+        const char *name = SDL_GameControllerGetStringForButton(static_cast<SDL_GameControllerButton>(pad_input));
+        if (name && *name) return name;
+    }
+    return "none";
+}
+
+namespace {
+// 'pad_cross = a': SDL's controller button names (a, b, x, y, back, start, guide, leftstick, rightstick, leftshoulder,
+// rightshoulder, dpup, dpdown, dpleft, dpright, misc1, paddle1 to paddle4, touchpad), the two triggers, and a few short names
+bool lookup_pad(const std::string &text, int &pad_input) {
+    const std::string v = squash(text);
+    if (v == "none" || v.empty()) return pad_input = kPadNone, true;
+    if (v == "lefttrigger" || v == "lt" || v == "l2" || v == "zl") return pad_input = kPadLeftTrigger, true;
+    if (v == "righttrigger" || v == "rt" || v == "r2" || v == "zr") return pad_input = kPadRightTrigger, true;
+    for (int i = 0; i < 8; ++i)
+        if (v == squash(kStickWords[i])) return pad_input = kPadStickBase + i, true;
+    static const std::map<std::string, int> shorts = {
+        {"lb", SDL_CONTROLLER_BUTTON_LEFTSHOULDER}, {"rb", SDL_CONTROLLER_BUTTON_RIGHTSHOULDER}, {"l1", SDL_CONTROLLER_BUTTON_LEFTSHOULDER},
+        {"r1", SDL_CONTROLLER_BUTTON_RIGHTSHOULDER}, {"ls", SDL_CONTROLLER_BUTTON_LEFTSTICK}, {"rs", SDL_CONTROLLER_BUTTON_RIGHTSTICK},
+        {"l3", SDL_CONTROLLER_BUTTON_LEFTSTICK}, {"r3", SDL_CONTROLLER_BUTTON_RIGHTSTICK}, {"view", SDL_CONTROLLER_BUTTON_BACK},
+        {"select", SDL_CONTROLLER_BUTTON_BACK}, {"menu", SDL_CONTROLLER_BUTTON_START}, {"dpadup", SDL_CONTROLLER_BUTTON_DPAD_UP},
+        {"dpaddown", SDL_CONTROLLER_BUTTON_DPAD_DOWN}, {"dpadleft", SDL_CONTROLLER_BUTTON_DPAD_LEFT}, {"dpadright", SDL_CONTROLLER_BUTTON_DPAD_RIGHT}};
+    if (const auto it = shorts.find(v); it != shorts.end()) return pad_input = it->second, true;
+    const SDL_GameControllerButton b = SDL_GameControllerGetButtonFromString(v.c_str());
+    if (b == SDL_CONTROLLER_BUTTON_INVALID) return false;
+    pad_input = b;
+    return true;
+}
