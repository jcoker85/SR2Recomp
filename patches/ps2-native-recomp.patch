+// How far a controller input is pushed, 0 to 1: a button 0 or 1, a trigger, or one side of a stick axis (keymap kPadStickBase)
+double pad_amount(SDL_GameController *pad, int source) {
+    if (source == keymap::kPadLeftTrigger || source == keymap::kPadRightTrigger)
+        return SDL_GameControllerGetAxis(pad, source == keymap::kPadLeftTrigger ? SDL_CONTROLLER_AXIS_TRIGGERLEFT : SDL_CONTROLLER_AXIS_TRIGGERRIGHT) / 32767.0;
+    if (source >= keymap::kPadStickBase && source < keymap::kPadStickBase + 8) {
+        const int k = source - keymap::kPadStickBase;
+        const int v = SDL_GameControllerGetAxis(pad, static_cast<SDL_GameControllerAxis>(k / 2));
+        return std::clamp((k % 2 ? v : -v) / 32767.0, 0.0, 1.0);
+    }
+    if (source >= 0 && source < SDL_CONTROLLER_BUTTON_MAX) return SDL_GameControllerGetButton(pad, static_cast<SDL_GameControllerButton>(source)) ? 1.0 : 0.0;
+    return 0.0;
+}
